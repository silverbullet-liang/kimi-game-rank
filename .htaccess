# ============================================================
#  Kimi游戏榜  Apache 配置（共享主机兼容版）
# ============================================================

# ---------- 静态资源 MIME 修正（ES Module 与字体必需） ----------
# 若服务器把 .js 返回为 text/plain，浏览器会拒绝加载模块脚本
# woff2 若被当作 application/octet-stream 返回，字体可能被浏览器拒绝
<IfModule mod_mime.c>
    AddType text/javascript .js .mjs
    AddType text/css .css
    AddType image/svg+xml .svg
    AddType font/woff2 .woff2
</IfModule>
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 强制 HTTPS
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 透传 Authorization（Bearer 登录态必需）
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # ---------- 端点规整化：对外一律无扩展名 ----------
    # /api/works 等价 /api/works.php；带 .php 的旧地址继续可用，外部调用与旧缓存不受影响
    RewriteRule ^api/([a-zA-Z0-9_-]+)/?$ api/$1.php [L,QSA]

    # SEO 端点：动态生成（按当前域名给出正确的 Sitemap 地址；镜像站 Disallow All）
    RewriteRule ^robots\.txt$ robots.php [L]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # ---------- 零后端 404：不存在的路径根本不启动 PHP ----------
    # 共享主机按 PHP 请求计「入口进程」，只要一条 URL 落到 index.php，就要跑一遍
    # 后端才给出 404。/probe/0 … /probe/24 那种批量扫描消耗入口进程正是靠这一点。
    # 目标：静态就能判定「不存在」的路径，一律由 ErrorDocument 输出纯静态 404.html。
    # 下面全部用相对路径匹配（per-dir 会自动去掉子目录前缀），部署在子目录也成立。

    # 1) 目录请求（URI 以 / 结尾，如 /docs/ 、/storage/ 、/assets/）：
    #    站点没有任何合法的目录地址，一律静态 404。用 URI 形态判定而不是 -d，
    #    因为子目录里的 .htaccess（storage 的 Require all denied）会抢先给 403，
    #    而 403 同样要走一次错误页。
    RewriteRule .+/$ - [R=404,L]

    # 2) 文档页：只认这 8 个 slug 与它们的中文名，其余 /docs/xxx 一律静态 404。
    #    「AI 使用说明」中间的空格用 \x20 表示，避免被当成分隔符。
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^docs/(features|ai|community|scoring|admission|terms|privacy|changelog|功能说明|AI\x20使用说明|社区公约|评分标准|入榜规则|用户协议|隐私政策|更新日志)(/|$) index.php [L,QSA]

    # 3) 首段不在前端路由白名单里 → 不做任何重写，Apache 直接 404，
    #    全程不进入 PHP。白名单与 app/seo.php 的 seo_route_segments() +
    #    seo_legacy_segments() 一一对应，新增对外路由段时必须同步这里，
    #    tools/verify_routes.php 会守住这条。
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule !^(|rankings|works|world|me|login|submit|feedback|about|banned|notices|admin|monitor|today|history|incident|rank|detail|doc|mine|violation|discipline|panel)(/|$) - [L]

    # 4) 白名单内的前端路由交给入口
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]

</IfModule>

# ---------- 传输压缩 ----------
# 样式表（尤其字体索引 fonts.css）与脚本是纯文本，压缩后体积大幅下降。
# woff2 本身已压缩，不重复处理。模块不存在时整段被忽略，不影响主机兼容性。
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---------- 静态资源长缓存 ----------
# 字体文件名带内容哈希、样式与脚本 URL 带 ?v=APP_VERSION，内容变更必然换名，可安全长缓存。
# 本主机默认只给 css/js 缓存（30 天），而 woff2 为 max-age=0（每次重下），此处显式覆盖。
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType application/json "access plus 30 days"
    # 文档 md 请求带 ?v=APP_VERSION（版本不变即命中缓存），可安全长缓存
    ExpiresByType text/markdown "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpe?g|gif|webp|avif|svg)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.md$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

# 敏感路径与文件直接 404（mod_alias）
# 敏感目录拦截：只列真正不该被直接访问的源码与数据目录。
# 注意 docs 不能在这里 —— 它同时是文档页的对外段名（/docs/scoring），
# 一旦列入，文档页会被直接 404（ErrorDocument 兜底成「页面不见了」）。
RedirectMatch 404 ^/(config|storage|sql|app|tools)/.*$
RedirectMatch 404 \.(sql|log|ini|lock|bak|old|orig|save|swp|zip)$

# ---------- 自定义错误页 ----------
# 400/401/403/405/408/429/5xx 指向 error.php：自包含、不依赖 bootstrap 与外部资源，
# 并读取 kimgr_skin cookie 按当前皮肤切换设计语言。这些码由具体接口主动触发，量可控。
# 404 例外：它是扫描与批量探测唯一会撞到的错误码，必须零 PHP ——
# 交给纯静态 404.html，否则每打一条不存在的路径就白跑一个入口进程。
# 403 同理统一回 404.html：目录探测（storage 等子目录 .htaccess 一律 deny）
# 走的就是 403，既不能跑 PHP，也不该向外确认「这个目录存在」。
ErrorDocument 400 /error.php?code=400
ErrorDocument 401 /error.php?code=401
ErrorDocument 403 /404.html
ErrorDocument 404 /404.html
ErrorDocument 405 /error.php?code=405
ErrorDocument 408 /error.php?code=408
ErrorDocument 429 /error.php?code=429
ErrorDocument 500 /error.php?code=500
ErrorDocument 502 /error.php?code=502
ErrorDocument 503 /error.php?code=503
