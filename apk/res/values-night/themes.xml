<?xml version="1.0" encoding="utf-8"?>
<!-- 深色下状态栏图标改白色；其余由 Material3 DayNight 自动处理 -->
<resources>
    <style name="Theme.KimiDeploy" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/kd_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/kd_surface</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="colorPrimary">@color/kd_primary</item>
        <item name="colorOnPrimary">@color/kd_on_primary</item>
        <item name="colorPrimaryContainer">@color/kd_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/kd_on_primary_container</item>
        <item name="colorSecondary">@color/kd_primary</item>
        <item name="colorSecondaryContainer">@color/kd_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/kd_on_secondary_container</item>
        <item name="android:colorBackground">@color/kd_surface</item>
        <item name="colorSurface">@color/kd_surface</item>
        <item name="colorSurfaceContainerLow">@color/kd_surface_low</item>
        <item name="colorSurfaceContainer">@color/kd_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/kd_surface_high</item>
        <item name="colorOnSurface">@color/kd_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/kd_on_surface_variant</item>
        <item name="colorOutline">@color/kd_outline</item>
        <item name="colorOutlineVariant">@color/kd_outline_variant</item>
        <item name="colorError">@color/kd_error</item>
        <item name="colorOnError">@color/kd_on_error</item>
        <item name="colorErrorContainer">@color/kd_error_container</item>
        <item name="colorOnErrorContainer">@color/kd_on_error_container</item>
    </style>
</resources>
