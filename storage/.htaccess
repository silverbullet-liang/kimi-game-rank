# ============================================================
#  storage 目录访问控制
# ------------------------------------------------------------
#  这里只有日志、缓存、访问记录落盘文件与用户上传的图片，
#  没有一样需要通过网址直接访问：
#    · 上传图片一律经 api/media.php 校验后读取；
#    · 日志与缓存更不该外泄（含路径、报错与内部痕迹）。
#  根目录 .htaccess 里已有一条 RedirectMatch 404 规则，
#  但它锚定在网站根（^/storage…），站点若部署在子目录就会失效；
#  这个文件按目录生效，位置怎么变都拦得住。
# ============================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2 / 部分 LiteSpeed 环境
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
