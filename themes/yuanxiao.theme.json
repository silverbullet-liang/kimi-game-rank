    "html": "<i class=\"fd-night\"></i><i class=\"fd-lamp fd-l1\"></i><i class=\"fd-lamp fd-l2\"></i><i class=\"fd-lamp fd-l3\"></i><span class=\"fd-glow\"></span>",
    "css": ".fd-night{position:fixed;top:0;left:0;width:100%;height:10vh;background:linear-gradient(180deg,rgba(75,58,107,.26),rgba(75,58,107,0));pointer-events:none}.fd-lamp{position:fixed;top:1vh;width:24px;height:28px;border-radius:50% 50% 46% 46%;background:radial-gradient(circle at 40% 34%,#F0836A,#C0341F 72%);box-shadow:0 -14px 0 -13px rgba(192,52,31,.55),0 0 16px 5px rgba(240,131,106,.3);animation:fd-sway 9s ease-in-out infinite;pointer-events:none}.fd-l1{left:4vw}.fd-l2{right:5vw;top:2vh;width:18px;height:21px;animation-duration:11s}.fd-l3{right:7vw;top:1.2vh;width:14px;height:17px;opacity:.8}.fd-glow{position:fixed;bottom:0;left:0;width:100%;height:7vh;background:linear-gradient(0deg,rgba(240,131,106,.24),rgba(240,131,106,0));pointer-events:none}@keyframes fd-sway{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(2deg)}}@media (prefers-reduced-motion: reduce){.fd-lamp{animation:none}}"
