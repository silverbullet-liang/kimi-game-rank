    "html": "<div class=\"fd-sky\"></div><div class=\"fd-burst\"></div><i class=\"fd-spark\"></i><i class=\"fd-spark2\"></i><span class=\"fd-spark3\"></span>",
    "css": ".fd-sky{position:fixed;left:0;right:0;top:0;height:9vh;background:linear-gradient(180deg,rgba(31,42,87,.28),transparent);pointer-events:none}.fd-burst{position:fixed;right:8vw;top:3vh;width:76px;height:76px;border-radius:50%;box-shadow:0 0 0 2px rgba(232,196,104,.28),0 0 26px rgba(232,196,104,.45);background:radial-gradient(circle,rgba(232,196,104,.4),transparent 70%);animation:fd-twinkle 7s ease-in-out infinite;pointer-events:none}.fd-spark{position:fixed;right:7.5vw;top:2vh;display:block;width:18px;height:2px;background:rgba(232,196,104,.6);transform:rotate(-30deg);pointer-events:none}.fd-spark2{position:fixed;right:4vw;top:6vh;display:block;width:22px;height:2px;background:rgba(232,196,104,.5);transform:rotate(24deg);pointer-events:none}.fd-spark3{position:fixed;left:6vw;top:4vh;display:block;width:9px;height:9px;background:rgba(232,196,104,.55);border-radius:50%;pointer-events:none}@keyframes fd-twinkle{0%{opacity:.35;transform:scale(.94)}50%{opacity:.9;transform:scale(1.04)}100%{opacity:.35;transform:scale(.94)}}@media (prefers-reduced-motion: reduce){.fd-burst{animation:none}}"
