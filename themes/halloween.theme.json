    "css": ".fd-moon{position:fixed;top:2vh;left:2vw;width:64px;height:64px;border-radius:50%;background:radial-gradient(circle at 38% 34%,rgba(230,224,210,.88),rgba(230,224,210,.26) 62%,rgba(230,224,210,0) 76%);box-shadow:0 0 36px rgba(230,224,210,.22);pointer-events:none}\n.fd-pumpkin{position:fixed;bottom:0;right:1vw;width:96px;height:62px;border-radius:50%;background:radial-gradient(circle at 40% 34%,rgba(233,114,12,.52),rgba(233,114,12,.12) 66%,rgba(233,114,12,0) 78%);filter:blur(1px);pointer-events:none}\n.fd-bat{position:fixed;top:7vh;right:6vw;width:30px;height:12px;border-radius:60% 60% 40% 40%;background:rgba(230,224,210,.32);animation:fd-flit 13s ease-in-out infinite;pointer-events:none}\n.fd-fog{position:fixed;left:0;bottom:0;width:100%;height:6vh;border-radius:50% 50% 0 0/60% 60% 0 0;background:linear-gradient(180deg,rgba(123,170,79,.12),rgba(123,170,79,0));pointer-events:none}\n@keyframes fd-flit{0%,100%{transform:translate(0,0)}50%{transform:translate(-10px,-4px)}}\n@media (prefers-reduced-motion: reduce){.fd-bat{animation:none}}"
