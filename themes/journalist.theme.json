  "deco": {
    "html": "<div class=\"fd-paper\"></div><div class=\"fd-redmark\"></div><i class=\"fd-rule\"></i><span class=\"fd-spot\"></span>",
    "css": ".fd-paper{position:fixed;top:0;left:0;width:7vw;height:9vh;background:repeating-linear-gradient(180deg,rgba(35,32,28,.12) 0 1px,rgba(35,32,28,0) 1px 12px);opacity:.7;pointer-events:none}\n.fd-redmark{position:fixed;top:3vh;right:4vw;width:30px;height:30px;border-radius:50%;border:2px solid rgba(179,39,31,.34);animation:fd-blot 8s ease-in-out infinite;pointer-events:none}\n.fd-rule{position:fixed;left:0;bottom:3vh;width:100%;height:2px;background:linear-gradient(90deg,rgba(35,32,28,0),rgba(35,32,28,.24),rgba(35,32,28,0));pointer-events:none}\n.fd-spot{position:fixed;top:0;right:0;width:8vw;height:10vh;background:radial-gradient(ellipse at 100% 0,rgba(179,39,31,.10),rgba(179,39,31,0) 70%);pointer-events:none}\n@keyframes fd-blot{0%,100%{opacity:.55}50%{opacity:1}}\n@media (prefers-reduced-motion: reduce){.fd-redmark{animation:none}}"
